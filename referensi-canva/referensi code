function nav(route){state.route=routes.some(r=>r[0]===route)?route:'portal';$('main-content').innerHTML=render();$('top-title').textContent=routes.find(r=>r[0]===state.route)[1];$('breadcrumb').textContent='Sistem Manajemen BMN / '+$('top-title').textContent;$('side-nav').innerHTML=routes.map(([key,label,ico])=>`<button class="nav-btn canva-button ${key===state.route?'active':''}" data-route="${key}" ${key===state.route?'aria-current="page"':''}>${icon(ico)} ${label}</button>`).join('');closeMenu();refreshIcons();window.scrollTo({top:0,behavior:'instant'})}
function closeMenu(){$('sidebar').classList.remove('open');$('mobile-overlay').classList.remove('open');$('menu-toggle').setAttribute('aria-expanded','false')}
function render(){return ({portal,login,dashboard,aset:assetPage,peminjaman:loanPage,pengembalian:returnPage,laporan,formulir,dokumen})[state.route]()}
function portal(){const cards=[['Login Admin','Akses tampilan administrasi dan pemantauan BMN.','login','shield-check'],['Formulir Pengelolaan','Ajukan kebutuhan dan perubahan pengelolaan barang.','formulir','clipboard-list'],['Pusat Dokumen','Temukan kategori dokumen administrasi BMN.','dokumen','folder-open'],['Peminjaman','Tinjau daftar permohonan peminjaman aset.','peminjaman','arrow-up-right'],['Pengembalian','Pantau dan proses pengembalian aset.','pengembalian','rotate-ccw'],['Laporan','Lihat rekapitulasi dan ringkasan pengelolaan.','laporan','chart-column']];return `<header class="portal-header canva-header"><div class="brand"><div class="brand-mark">LOGO<br>BPOM</div><div><strong>BALAI POM DI ENDE</strong><small>SISTEM MANAJEMEN BARANG MILIK NEGARA</small></div></div><span class="eyebrow">PORTAL LAYANAN DIGITAL</span></header><section class="hero canva-banner"><div><span class="eyebrow">BALAI POM DI ENDE · PORTAL LAYANAN DIGITAL</span><h2>Selamat Datang di<br>Sistem Manajemen BMN</h2><p><strong>Kelola aset BMN dengan mudah dan tertib.</strong><br>Portal layanan Barang Milik Negara untuk mendukung administrasi yang transparan dan akuntabel.</p>${button('Jelajahi Layanan '+icon('arrow-right'),'services','white')}</div><div class="hero-art" aria-hidden="true">${icon('boxes')}</div><div class="hero-identity"><div class="logo-placeholder">LOGO<br>BMN</div></div></section><section id="services" class="canva-section"><div class="section-title"><h3>Pilih Jenis Akses</h3><span class="crumb">Layanan BMN Balai POM di Ende</span></div><div class="grid services">${cards.map(([title,desc,route,ico])=>`<article class="card canva-card"><div class="card-icon">${icon(ico)}</div><h3>${title}</h3><p>${desc}</p><button class="text-link canva-button" data-route="${route}">Buka layanan ${icon('arrow-right')}</button></article>`).join('')}</div></section><section class="canva-section"><div class="section-title"><h3>Nilai layanan</h3></div><div class="values">${['Profesional','Integritas','Kredibel','Kerja Sama','Inovatif'].map(x=>`<span class="canva-tag">${x}</span>`).join('')}</div></section><footer class="portal-footer canva-footer"><span>Balai POM di Ende · Sistem Manajemen BMN</span><strong>Aset Tertib, Dukung Kinerja untuk Negeri</strong></footer>`}
function login(){return `<div class="login-layout"><section class="login-side canva-panel"><div class="logo-placeholder">LOGO<br>BPOM</div><div><span class="eyebrow">AKSES ADMIN · DEMONSTRASI</span><h2>Sistem Manajemen BMN Balai POM di Ende</h2><p>Kelola aset dan alur administrasi dalam satu ruang kerja yang tertib dan mudah dipantau.</p></div><small>Aset Tertib, Dukung Kinerja untuk Negeri</small></section><section class="panel canva-panel"><div class="card-icon">${icon('shield-check')}</div><h2>Login Admin</h2><p class="form-note">Pratinjau akses admin. Halaman ini tidak meminta kata sandi dan tidak melakukan autentikasi. Gunakan penyedia autentikasi resmi untuk implementasi produksi.</p><div class="notice canva-banner">Mode demo: data aset dan status hanya berlaku selama halaman ini terbuka.</div><div style="display:flex;gap:9px;flex-wrap:wrap;margin-top:20px">${button('Masuk ke dashboard demo '+icon('arrow-right'),'dashboard','primary')}${button('Kembali ke portal layanan','portal')}</div></section></div>`}
function dashboard(){return `${heading('RINGKASAN ADMINISTRASI','Dashboard Admin','Selamat datang di Sistem Manajemen BMN Balai POM di Ende. Kelola aset secara transparan dan akuntabel.')}<div class="grid stats">${[['Total aset','348','Data inventaris BMN'],['Peminjaman aktif','12','Permohonan berjalan'],['Menunggu persetujuan','3','Perlu ditinjau'],['Pengembalian jatuh tempo','5','Perlu ditindaklanjuti']].map(([l,v,s])=>`<article class="stat canva-card"><small>${l}</small><strong>${v}</strong><span class="mini">${s}</span></article>`).join('')}</div><div class="two-cols"><section class="panel canva-panel"><h3>Grafik aset menurut kategori</h3><div class="chart" role="img" aria-label="Elektronik 142, perabot 116, ruangan 58, lainnya 32">${[['Elektronik',142],['Perabot',116],['Ruangan',58],['Lainnya',32]].map(([n,v])=>`<div class="bar-slot"><div class="bar" style="height:${v}px"></div><small>${n}<br>${v}</small></div>`).join('')}</div></section><section class="panel canva-panel"><h3>Ringkasan status</h3><div class="status-summary"><span>Tersedia · 328</span><span>Dipinjam · 12</span><span>Pemeliharaan · 8</span></div></section></div><div class="two-cols" style="margin-top:18px"><section class="panel canva-panel"><h3>Aktivitas terbaru</h3><ul class="activity canva-list"><li><span class="dot"></span><div>Permohonan peminjaman diajukan oleh Siti Rahmawati<small>12 Juni 2025 · Laptop HP ProBook 440 G9</small></div></li><li><span class="dot"></span><div>Pengembalian proyektor tercatat tepat waktu<small>11 Juni 2025 · Budi Santoso</small></div></li><li><span class="dot"></span><div>Data inventaris AC Split memerlukan pemeliharaan<small>10 Juni 2025 · Ruang Pelayanan</small></div></li></ul></section><section class="panel canva-panel"><h3>Akses cepat</h3><div class="quick">${[['Tambah data aset','aset','plus'],['Tinjau permohonan','peminjaman','clipboard-check'],['Lihat laporan','laporan','chart-column'],['Buka formulir','formulir','file-text']].map(([t,r,i])=>`<button class="canva-button" data-route="${r}">${icon(i)} ${t}</button>`).join('')}</div></section></div>`}
function assetPage(){return `${heading('INVENTARIS','Master Aset','Kelola data contoh aset BMN dan pantau kondisi barang.')}<button id="add-asset" class="btn btn-primary canva-button">${icon('plus')} Tambah Aset</button><div class="toolbar"><div class="field search-field"><label for="asset-search">Cari aset</label><input id="asset-search" class="canva-input" placeholder="Kode, nama, atau lokasi" value="${esc(state.assetQuery)}"></div><div class="field"><label for="asset-category">Kategori</label><select id="asset-category" class="canva-dropdown"><option value="">Semua kategori</option>${['Ruangan','Elektronik','Perabot'].map(x=>`<option ${state.category===x?'selected':''}>${x}</option>`).join('')}</select></div><div class="field"><label for="asset-condition">Kondisi</label><select id="asset-condition" class="canva-dropdown"><option value="">Semua kondisi</option>${['Baik','Perlu pemeliharaan','Rusak'].map(x=>`<option ${state.condition===x?'selected':''}>${x}</option>`).join('')}</select></div></div><div id="asset-results"></div>`}
function renderAssets(){let data=assets.filter(a=>(a.code+' '+a.name+' '+a.location).toLowerCase().includes(state.assetQuery.toLowerCase())&&(!state.category||a.category===state.category)&&(!state.condition||a.condition===state.condition));data.sort((a,b)=>state.direction*String(a[state.sort]).localeCompare(String(b[state.sort]),'id'));const pages=Math.max(1,Math.ceil(data.length/5));state.page=Math.min(state.page,pages);const shown=data.slice((state.page-1)*5,state.page*5);$('asset-results').innerHTML=`<div class="table-wrap canva-table">${data.length?`<table><thead><tr>${[['code','Kode aset'],['name','Nama aset'],['location','Lokasi'],['category','Kategori'],['condition','Kondisi']].map(([key,label])=>`<th><button class="sort-btn canva-button" data-sort="${key}" aria-label="Urutkan berdasarkan ${label}">${label} ${state.sort===key?(state.direction===1?'↑':'↓'):''}</button></th>`).join('')}<th>Status</th><th>Aksi</th></tr></thead><tbody>${shown.map(a=>`<tr><td>${esc(a.code)}</td><td><strong>${esc(a.name)}</strong><br><span style="color:var(--muted)">${esc(a.category)}</span></td><td>${esc(a.location)}</td><td>${esc(a.category)}</td><td>${badge(a.condition)}</td><td>${badge(a.condition==='Baik'?'Tersedia':'Pemeliharaan')}</td><td><div class="row-actions"><button data-asset-action="detail" data-code="${esc(a.code)}">Detail</button><button data-asset-action="edit" data-code="${esc(a.code)}">Edit</button><button data-asset-action="delete" data-code="${esc(a.code)}">Hapus</button></div></td></tr>`).join('')}</tbody></table>`:`<div class="empty">Tidak ada aset yang sesuai dengan pencarian atau filter.</div>`}</div><div class="pagination"><span>Menampilkan ${shown.length} dari ${data.length} aset · Halaman ${state.page} dari ${pages}</span><div><button class="btn btn-outline btn-sm canva-button" data-page="-1" ${state.page===1?'disabled':''}>Sebelumnya</button><button class="btn btn-outline btn-sm canva-button" data-page="1" ${state.page===pages?'disabled':''}>Berikutnya</button></div></div>`;refreshIcons()}
function loanPage(){return `${heading('PERMOHONAN','Peminjaman Aset','Tinjau dan kelola permohonan peminjaman barang milik negara.')}<div class="grid stats">${[['Permohonan','12'],['Menunggu persetujuan','3'],['Disetujui','7'],['Ditolak','2']].map(([l,v])=>`<div class="stat canva-card"><small>${l}</small><strong>${v}</strong></div>`).join('')}</div><button id="new-loan" class="btn btn-primary canva-button">${icon('plus')} Ajukan Peminjaman</button><div class="toolbar"><div class="field search-field"><label for="loan-search">Cari permohonan</label><input id="loan-search" class="canva-input" placeholder="Nama pemohon, aset, atau keperluan" value="${esc(state.loanQuery)}"></div><div class="field"><label for="loan-period">Periode pengajuan</label><input id="loan-period" type="month" class="canva-input" value="${esc(state.period)}"></div></div><div id="loan-results"></div>`}
function renderLoans(){let data=loans.filter(x=>(x.person+' '+x.asset+' '+x.purpose).toLowerCase().includes(state.loanQuery.toLowerCase())&&(!state.period||x.date.startsWith(state.period)));$('loan-results').innerHTML=`<div class="table-wrap canva-table">${data.length?`<table><thead><tr><th>Tanggal Pengajuan</th><th>Nama Pemohon</th><th>Aset yang Dipinjam</th><th>Keperluan</th><th>Status</th><th>Aksi</th></tr></thead><tbody>${data.map(x=>`<tr><td>${x.date}</td><td><strong>${esc(x.person)}</strong></td><td>${esc(x.asset)}</td><td>${esc(x.purpose)}</td><td>${badge(x.status)}</td><td><div class="row-actions"><button data-loan="${x.id}">Tinjau permohonan</button></div></td></tr>`).join('')}</tbody></table>`:`<div class="empty">Tidak ada permohonan yang sesuai.</div>`}</div>`}
function returnPage(){return `${heading('PENGEMBALIAN','Pengembalian Aset','Pantau jadwal dan catat status pengembalian aset.')}<div class="toolbar"><div class="field search-field"><label for="return-search">Cari pengembalian</label><input id="return-search" class="canva-input" placeholder="Nama aset, peminjam, atau tanggal" value="${esc(state.returnQuery)}"></div><div class="field"><label for="return-status">Status</label><select id="return-status" class="canva-dropdown"><option value="">Semua status</option>${['Menunggu pengembalian','Tepat waktu','Terlambat'].map(s=>`<option ${state.returnStatus===s?'selected':''}>${s}</option>`).join('')}</select></div></div><div id="return-results"></div>`}
function renderReturns(){let data=returns.filter(x=>(x.asset+' '+x.person+' '+x.date).toLowerCase().includes(state.returnQuery.toLowerCase())&&(!state.returnStatus||x.status===state.returnStatus));$('return-results').innerHTML=`<div class="table-wrap canva-table">${data.length?`<table><thead><tr><th>Nama aset</th><th>Peminjam</th><th>Tanggal pengembalian</th><th>Status</th><th>Aksi</th></tr></thead><tbody>${data.map(x=>`<tr><td><strong>${esc(x.asset)}</strong></td><td>${esc(x.person)}</td><td>${x.date}</td><td>${badge(x.status)}</td><td><div class="row-actions"><button data-return="${x.id}">Proses pengembalian</button></div></td></tr>`).join('')}</tbody></table>`:`<div class="empty">Tidak ada pengembalian yang sesuai.</div>`}</div>`}
function laporan(){const months=['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];return `${heading('ANALISIS DATA','Laporan BMN','Rekapitulasi contoh untuk pemantauan aset dan aktivitas administrasi.')}<div class="toolbar"><div class="field"><label for="report-month">Bulan</label><select id="report-month" class="canva-dropdown"><option value="">Semua bulan</option>${months.map((m,i)=>`<option value="${i+1}" ${state.month==i+1?'selected':''}>${m}</option>`).join('')}</select></div><div class="field"><label for="report-year">Tahun</label><select id="report-year" class="canva-dropdown">${['2024','2025','2026'].map(y=>`<option ${state.year===y?'selected':''}>${y}</option>`).join('')}</select></div><div class="field"><label for="report-type">Jenis laporan</label><select id="report-type" class="canva-dropdown">${['Semua jenis','Inventaris aset','Peminjaman','Pengembalian'].map(x=>`<option ${state.reportType===x?'selected':''}>${x}</option>`).join('')}</select></div><button id="print-report" class="btn btn-outline canva-button">${icon('printer')} Cetak</button><button id="export-report" class="btn btn-primary canva-button">${icon('copy')} Salin CSV</button></div><p class="form-note">Ringkasan berikut merupakan data contoh. Filter menentukan judul periode laporan; hubungkan sumber data operasional untuk rekapitulasi dinamis.</p><div id="report-period" class="eyebrow" style="margin-top:20px"></div><div class="grid stats">${[['Total aset','348'],['Peminjaman aktif','12'],['Persetujuan tertunda','3'],['Jatuh tempo','5']].map(([l,v])=>`<div class="stat canva-card"><small>${l}</small><strong>${v}</strong></div>`).join('')}</div><div class="two-cols"><section class="panel canva-panel"><h3>Gambaran aset menurut kategori</h3><div class="chart" role="img" aria-label="Grafik contoh: elektronik 142, perabot 116, ruangan 58, lainnya 32">${[['Elektronik',142],['Perabot',116],['Ruangan',58],['Lainnya',32]].map(([n,v])=>`<div class="bar-slot"><div class="bar" style="height:${v}px" title="${n}: ${v}"></div><small>${n}<br>${v}</small></div>`).join('')}</div></section><section class="panel canva-panel"><h3>Catatan laporan</h3><p class="form-note">Grafik dan angka ringkasan merupakan ilustrasi data lokal. Gunakan tombol cetak untuk membuka dialog cetak browser atau salin CSV untuk menyalin tabel rekapitulasi.</p></section></div><div class="section-title"><h3>Tabel rekapitulasi</h3></div><div class="table-wrap canva-table"><table><thead><tr><th>Kategori</th><th>Jumlah aset</th><th>Keterangan</th></tr></thead><tbody><tr><td>Elektronik</td><td>142</td><td>Inventaris perangkat</td></tr><tr><td>Perabot</td><td>116</td><td>Perlengkapan ruang kerja</td></tr><tr><td>Ruangan</td><td>58</td><td>Fasilitas kerja</td></tr><tr><td>Lainnya</td><td>32</td><td>Aset kategori lainnya</td></tr></tbody></table></div>`}
function formulir(){return `${heading('LAYANAN PEGAWAI','Formulir Pengelolaan BMN','Sampaikan pengajuan administrasi barang milik negara secara tertib.')}<div class="tabs canva-tabs" role="tablist" aria-label="Jenis formulir">${formTabs.map((x,i)=>`<button class="tab canva-button ${i===state.tab?'active':''}" role="tab" aria-selected="${i===state.tab}" data-tab="${i}">${x}</button>`).join('')}</div><section class="panel canva-panel"><h3 id="form-title">${formTabs[state.tab]}</h3><p class="form-note">Isi seluruh kolom wajib. Nama berkas lampiran dicatat sebagai referensi; isi berkas tidak diunggah.</p><form id="submission-form" novalidate><div class="form-grid"><div class="field"><label for="applicant">Nama pengaju *</label><input id="applicant" name="applicant" class="canva-input" required autocomplete="name"></div><div class="field"><label for="unit">Unit kerja *</label><input id="unit" name="unit" class="canva-input" required></div><div class="field"><label for="item-name">Nama barang / kebutuhan *</label><input id="item-name" name="item" class="canva-input" required></div><div class="field"><label for="request-date">Tanggal pengajuan *</label><input id="request-date" name="date" type="date" class="canva-input" required></div><div class="field"><label for="request-type">${formConfigs[state.tab].label} *</label><select id="request-type" class="canva-dropdown" required><option value="">Pilih ${formConfigs[state.tab].label.toLowerCase()}</option>${formConfigs[state.tab].options.map(x=>`<option>${x}</option>`).join('')}</select></div><div class="field"><label for="request-extra">${formConfigs[state.tab].extra} *</label><input id="request-extra" class="canva-input" required></div><div class="field"><label for="request-quantity">Jumlah barang *</label><input id="request-quantity" type="number" min="1" class="canva-input" required></div><div class="field"><label for="request-condition">Kondisi barang *</label><select id="request-condition" class="canva-dropdown" required><option value="">Pilih kondisi</option><option>Baik</option><option>Perlu pemeriksaan</option><option>Rusak</option></select></div><div class="field wide"><label for="request-description">Keterangan / keperluan *</label><textarea id="request-description" name="description" class="canva-input" required placeholder="Jelaskan kebutuhan, lokasi, atau kondisi barang sesuai jenis formulir."></textarea></div><div class="field wide"><label for="attachment">Dokumen / foto pendukung (opsional)</label><input id="attachment" name="attachment" type="file" class="canva-input" accept=".pdf,.jpg,.jpeg,.png"><span class="form-note">Hanya nama berkas yang dicatat. Jangan pilih berkas yang memuat informasi sensitif.</span></div><label class="checkline wide" for="declaration"><input id="declaration" type="checkbox" required> Saya menyatakan informasi yang disampaikan sesuai dengan keadaan sebenarnya. *</label></div><div class="modal-actions"><button type="button" id="save-draft" class="btn btn-outline canva-button">Simpan Draft</button><button type="reset" class="btn btn-outline canva-button">Reset</button><button type="submit" class="btn btn-primary canva-button">${icon('send')} Kirim Formulir</button></div><div id="form-errors" class="error-text" role="alert"></div><p id="form-message" class="form-note" role="status" aria-live="polite"></p></form></section><section class="panel canva-panel form-history"><h3>Draft dan riwayat sesi ini</h3><ul id="draft-list" class="activity canva-list">${drafts.length?drafts.map((d,i)=>`<li><span class="dot"></span><span>${esc(d.type)} · ${esc(d.person)} · ${esc(d.item)} <small>${esc(d.status)}</small></span>${d.status==='Draft'?`<button class="btn btn-outline btn-sm canva-button" data-draft="${i}">Buka draft</button>`:''}</li>`).join(''):'<li>Belum ada draft atau pengajuan pada sesi ini.</li>'}</ul></section>`}
function dokumen(){const docs=[['Stock Opname','Dokumen pemeriksaan fisik dan pencocokan inventaris.'],['Kartu Stok / SPB / SBBK','Dokumen pencatatan dan administrasi persediaan.'],['Laporan Keuangan','Referensi dokumen pelaporan terkait BMN.'],['Penghapusan BMN','Dokumen administrasi usulan penghapusan barang.']];return `<section class="hero canva-banner"><div><span class="eyebrow">BALAI POM DI ENDE · PUSAT DOKUMEN</span><h2>Pusat Dokumen<br>BMN</h2><p>Akses kategori dokumen administrasi, perencanaan, pencatatan, dan pelaporan Barang Milik Negara.</p>${button('Kembali ke portal','portal','white')}</div><div class="hero-identity"><div class="logo-placeholder">LOGO<br>BPOM</div></div></section><div class="section-title"><h3>Dokumen BMN</h3></div><div class="grid services">${docs.map(([title,desc],i)=>`<article class="card canva-card"><div class="card-icon">${icon('folder')}</div><h3>${title}</h3><p>${desc}</p><button class="text-link canva-button" data-doc="${i}">Lihat informasi ${icon('arrow-right')}</button></article>`).join('')}</div><p class="form-note" style="margin-top:20px">Berkas dokumen belum tersedia di aplikasi contoh ini. Hubungkan penyimpanan dokumen resmi sebelum menyediakan akses atau unduhan.</p>`}
function openModal(title,html){$('modal-title').textContent=title;$('modal-content').innerHTML=html;$('modal-backdrop').classList.add('open');refreshIcons();$('modal-close').focus()}
function closeModal(){$('modal-backdrop').classList.remove('open');$('modal-content').innerHTML=''}
function assetModal(code){const a=assets.find(x=>x.code===code);openModal(a?'Edit Aset':'Tambah Aset',`<form id="asset-form" class="form-grid" novalidate><div class="field"><label for="modal-code">Kode aset *</label><input id="modal-code" class="canva-input" required value="${esc(a?.code||'')}"></div><div class="field"><label for="modal-name">Nama aset *</label><input id="modal-name" class="canva-input" required value="${esc(a?.name||'')}"></div><div class="field"><label for="modal-category">Kategori</label><select id="modal-category" class="canva-dropdown">${['Ruangan','Elektronik','Perabot','Lainnya'].map(x=>`<option ${a?.category===x?'selected':''}>${x}</option>`).join('')}</select></div><div class="field"><label for="modal-location">Lokasi *</label><input id="modal-location" class="canva-input" required value="${esc(a?.location||'')}"></div><div class="field wide"><label for="modal-condition">Kondisi</label><select id="modal-condition" class="canva-dropdown">${['Baik','Perlu pemeliharaan','Rusak'].map(x=>`<option ${a?.condition===x?'selected':''}>${x}</option>`).join('')}</select></div><div class="modal-actions wide"><button type="button" class="btn btn-outline canva-button" data-close-modal>Batal</button><button type="submit" class="btn btn-primary canva-button">Simpan aset</button></div></form>`);$('asset-form').dataset.original=code||''}
function detailHtml(fields){return `<dl class="detail-list">${fields.map(([k,v])=>`<dt>${k}</dt><dd>${esc(v)}</dd>`).join('')}</dl>`}
function handleAssetAction(action,code){const a=assets.find(x=>x.code===code);if(!a)return;if(action==='edit')assetModal(code);if(action==='detail')openModal('Detail Aset',detailHtml([['Kode aset',a.code],['Nama aset',a.name],['Kategori',a.category],['Lokasi',a.location],['Kondisi',a.condition]]));if(action==='delete')openModal('Hapus Aset',`<p>Hapus <strong>${esc(a.name)}</strong> dari daftar contoh pada sesi ini?</p><div class="modal-actions"><button class="btn btn-outline canva-button" data-close-modal>Batal</button><button class="btn btn-danger canva-button" data-confirm-delete="${esc(code)}">Ya, hapus</button></div>`)}
function loanModal(id){const x=loans.find(a=>a.id===id);if(!x)return;openModal('Tinjau Permohonan',`${detailHtml([['Tanggal pengajuan',x.date],['Nama pemohon',x.person],['Aset',x.asset],['Keperluan',x.purpose],['Status',x.status]])}<div class="modal-actions"><button class="btn btn-outline canva-button" data-close-modal>Tutup</button>${x.status==='Menunggu persetujuan'?`<button class="btn btn-danger canva-button" data-loan-status="${id}:Ditolak">Tolak</button><button class="btn btn-primary canva-button" data-loan-status="${id}:Disetujui">Setujui</button>`:''}</div>`)}
function returnModal(id){const x=returns.find(a=>a.id===id);if(!x)return;openModal('Proses Pengembalian',`${detailHtml([['Aset',x.asset],['Peminjam',x.person],['Tanggal pengembalian',x.date],['Status saat ini',x.status]])}<div class="form-grid" style="margin-top:18px"><div class="field"><label for="return-actual">Tanggal aktual *</label><input id="return-actual" type="date" value="${esc(x.actual||'')}" required></div><div class="field"><label for="return-condition">Kondisi barang saat kembali *</label><select id="return-condition"><option value="">Pilih kondisi</option>${['Baik','Perlu pemeliharaan','Rusak'].map(s=>`<option ${x.condition===s?'selected':''}>${s}</option>`).join('')}</select></div><div class="field wide"><label for="return-note">Catatan</label><textarea id="return-note">${esc(x.note||'')}</textarea></div></div><div class="field" style="margin-top:18px"><label for="processed-status">Status pengembalian</label><select id="processed-status" class="canva-dropdown">${['Menunggu pengembalian','Tepat waktu','Terlambat'].map(s=>`<option ${x.status===s?'selected':''}>${s}</option>`).join('')}</select></div><div class="modal-actions"><button class="btn btn-outline canva-button" data-close-modal>Batal</button><button class="btn btn-primary canva-button" data-save-return="${id}">Simpan status</button></div>`)}
function reportPeriod(){const e=$('report-period');if(e)e.textContent=`PERIODE: ${state.month?$('report-month').selectedOptions[0].text:'SEMUA BULAN'} ${state.year} · ${state.reportType.toUpperCase()}`}
function copyCSV(){let text='Kategori,Jumlah aset,Keterangan\nElektronik,142,Inventaris perangkat\nPerabot,116,Perlengkapan ruang kerja\nRuangan,58,Fasilitas kerja\nLainnya,32,Aset kategori lainnya';let input=document.createElement('textarea');input.value=text;document.body.appendChild(input);input.select();const ok=document.execCommand('copy');input.remove();toast(ok?'Rekapitulasi CSV disalin.':'Tidak dapat menyalin CSV pada perangkat ini.')}
document.addEventListener('click',e=>{const t=e.target.closest('button');if(!t)return;if(t.dataset.route){if(t.dataset.route==='services'){nav('portal');setTimeout(()=>$('services')?.scrollIntoView({behavior:'smooth'}),0)}else nav(t.dataset.route);return}if(t.id==='menu-toggle'){$('sidebar').classList.toggle('open');$('mobile-overlay').classList.toggle('open');t.setAttribute('aria-expanded',$('sidebar').classList.contains('open'))}if(t.id==='logout-btn'){nav('login');toast('Kembali ke halaman akses admin. Tidak ada sesi autentikasi yang dibuat.')}if(t.id==='notification-btn')toast('Tidak ada notifikasi langsung. Angka dashboard merupakan data contoh.');if(t.id==='modal-close'||t.dataset.closeModal!==undefined)closeModal();if(t.id==='add-asset')assetModal();if(t.dataset.sort){state.direction=state.sort===t.dataset.sort?-state.direction:1;state.sort=t.dataset.sort;renderAssets()}if(t.dataset.page){state.page+=Number(t.dataset.page);renderAssets()}if(t.dataset.assetAction)handleAssetAction(t.dataset.assetAction,t.dataset.code);if(t.dataset.confirmDelete){assets=assets.filter(x=>x.code!==t.dataset.confirmDelete);closeModal();renderAssets();toast('Aset dihapus dari daftar contoh sesi ini.')}if(t.id==='new-loan')openModal('Ajukan Peminjaman',`<form id="new-loan-form" class="form-grid"><div class="field"><label for="new-person">Nama pemohon *</label><input id="new-person" required></div><div class="field"><label for="new-asset">Aset yang dipinjam *</label><input id="new-asset" required></div><div class="field"><label for="new-date">Tanggal pengajuan *</label><input id="new-date" type="date" required></div><div class="field"><label for="new-purpose">Keperluan *</label><input id="new-purpose" required></div><div class="modal-actions wide"><button type="submit" class="btn btn-primary canva-button">Ajukan</button></div></form>`);if(t.dataset.loan)loanModal(Number(t.dataset.loan));if(t.dataset.loanStatus){const [id,status]=t.dataset.loanStatus.split(':');loans.find(x=>x.id===Number(id)).status=status;closeModal();renderLoans();toast('Status permohonan diubah menjadi '+status+' pada sesi ini.')}if(t.dataset.return)returnModal(Number(t.dataset.return));if(t.dataset.saveReturn){if(!$('return-actual').value||!$('return-condition').value){toast('Isi tanggal aktual dan kondisi barang terlebih dahulu.');(!$('return-actual').value?$('return-actual'):$('return-condition')).focus();return}const r=returns.find(x=>x.id===Number(t.dataset.saveReturn));r.status=$('processed-status').value;r.actual=$('return-actual').value;r.condition=$('return-condition').value;r.note=$('return-note').value;closeModal();renderReturns();toast('Pengembalian diperbarui pada sesi ini.')}if(t.dataset.tab!==undefined){state.tab=Number(t.dataset.tab);$('main-content').innerHTML=formulir();refreshIcons()}if(t.dataset.doc!==undefined){let title=['Stock Opname','Kartu Stok / SPB / SBBK','Laporan Keuangan','Penghapusan BMN'][Number(t.dataset.doc)];openModal(title,`<p class="form-note">Kategori ${esc(title)} telah tersedia sebagai referensi navigasi. Belum ada berkas resmi yang terhubung untuk diakses atau diunduh.</p><div class="modal-actions"><button class="btn btn-outline canva-button" data-close-modal>Tutup</button></div>`)}if(t.id==='save-draft'){const f=$('submission-form');drafts.push({type:formTabs[state.tab],tab:state.tab,person:$('applicant').value||'Tanpa nama',item:$('item-name').value||'Belum diisi',status:'Draft',values:Object.fromEntries([...f.querySelectorAll('input:not([type=file]):not([type=checkbox]),select,textarea')].map(x=>[x.id,x.value]))});$('main-content').innerHTML=formulir();refreshIcons();toast('Draft tersimpan untuk sesi ini.')}if(t.dataset.draft!==undefined){let d=drafts[Number(t.dataset.draft)];state.tab=d.tab;$('main-content').innerHTML=formulir();Object.entries(d.values).forEach(([id,value])=>{if($(id))$(id).value=value});refreshIcons();$('submission-form').scrollIntoView({behavior:'smooth'})}if(t.id==='print-report')window.print();if(t.id==='export-report')copyCSV()});
document.addEventListener('input',e=>{const id=e.target.id;if(id==='asset-search'){state.assetQuery=e.target.value;state.page=1;renderAssets()}if(id==='loan-search'){state.loanQuery=e.target.value;renderLoans()}if(id==='return-search'){state.returnQuery=e.target.value;renderReturns()}});
document.addEventListener('change',e=>{const id=e.target.id;if(id==='asset-category'){state.category=e.target.value;state.page=1;renderAssets()}if(id==='asset-condition'){state.condition=e.target.value;state.page=1;renderAssets()}if(id==='loan-period'){state.period=e.target.value;renderLoans()}if(id==='return-status'){state.returnStatus=e.target.value;renderReturns()}if(id==='report-month'||id==='report-year'||id==='report-type'){state.month=$('report-month').value;state.year=$('report-year').value;state.reportType=$('report-type').value;reportPeriod()}});
document.addEventListener('submit',async e=>{if(e.target.id==='new-loan-form'){e.preventDefault();if(!e.target.reportValidity())return;loans.unshift({id:Date.now(),date:$('new-date').value,person:$('new-person').value.trim(),asset:$('new-asset').value.trim(),purpose:$('new-purpose').value.trim(),status:'Menunggu persetujuan'});closeModal();renderLoans();toast('Permohonan ditambahkan untuk sesi ini.')}if(e.target.id==='asset-form'){e.preventDefault();const form=e.target;if(!form.reportValidity())return;const original=form.dataset.original,code=$('modal-code').value.trim();if(assets.some(x=>x.code===code&&x.code!==original)){toast('Kode aset sudah digunakan.');return}const record={code,name:$('modal-name').value.trim(),category:$('modal-category').value,location:$('modal-location').value.trim(),condition:$('modal-condition').value};if(original)Object.assign(assets.find(x=>x.code===original),record);else assets.push(record);closeModal();renderAssets();toast('Data aset contoh berhasil diperbarui untuk sesi ini.')}if(e.target.id==='submission-form'){e.preventDefault();const form=e.target;if(!form.reportValidity()){const msg=$('form-message');msg.textContent='Lengkapi seluruh kolom wajib dan centang pernyataan.';$('form-errors').textContent='Periksa: '+[...form.querySelectorAll(':invalid')].map(x=>x.labels?.[0]?.textContent?.trim()||'Pernyataan').join(', ');form.querySelector(':invalid')?.focus();return}if(!sdkReady){$('form-message').textContent='Penyimpanan belum siap. Coba beberapa saat lagi.';return}const control=e.submitter;control.disabled=true;const old=control.innerHTML;control.textContent='Mengirim…';try{const record={jenis_formulir:formTabs[state.tab],nama_pengaju:$('applicant').value.trim(),unit_kerja:$('unit').value.trim(),nama_barang:$('item-name').value.trim(),tanggal:$('request-date').value,keterangan:`${$('request-description').value.trim()} | ${formConfigs[state.tab].label}: ${$('request-type').value} | ${formConfigs[state.tab].extra}: ${$('request-extra').value.trim()} | Jumlah: ${$('request-quantity').value} | Kondisi: ${$('request-condition').value}`,nama_lampiran:$('attachment').files[0]?.name||'',dibuat_pada:new Date().toISOString()};const result=await window.dataSdk.create(record);if(!result.isOk){$('form-message').textContent='Penyimpanan pengajuan tidak dapat dikonfirmasi. Periksa data sebelum mencoba kembali.';toast('Pengajuan belum dapat dikonfirmasi.')}else{drafts.push({type:formTabs[state.tab],person:record.nama_pengaju,item:record.nama_barang,status:'Terkirim'});form.reset();$('form-message').textContent='Pengajuan berhasil disimpan ke Canva Sheet. Lampiran tidak diunggah; hanya nama berkas yang dicatat.';$('draft-list').innerHTML=drafts.map((d,i)=>`<li><span class="dot"></span><span>${esc(d.type)} · ${esc(d.person)} · ${esc(d.item)} <small>${esc(d.status)}</small></span>${d.status==='Draft'?`<button class="btn btn-outline btn-sm canva-button" data-draft="${i}">Buka draft</button>`:''}</li>`).join('');toast('Pengajuan berhasil disimpan.')}}catch(err){$('form-message').textContent='Terjadi kendala saat menyimpan. Periksa data sebelum mencoba kembali.'}finally{control.disabled=false;control.innerHTML=old;refreshIcons()}}});
$('modal-backdrop').addEventListener('click',e=>{if(e.target===$('modal-backdrop'))closeModal()});$('mobile-overlay').addEventListener('click',closeMenu);document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeModal();closeMenu()}});
async function initStorage(){try{const result=await window.dataSdk.init({onDataChanged(){}});sdkReady=!!result.isOk;if(!sdkReady)toast('Penyimpanan formulir belum tersedia. Coba muat ulang halaman.')}catch(err){sdkReady=false;toast('Penyimpanan formulir belum tersedia. Coba muat ulang halaman.')}}
nav('portal');initStorage();
</script>
 </body>
